# Salin file ini menjadi .env.local dan isi dengan kredensial lokal.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/learn_with_glenn

# Buat secret acak sendiri, jangan gunakan nilai contoh yang dibagikan.
# Contoh generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
